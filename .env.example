# Copy to .env and adjust. docker-compose.yml loads .env into the qr-api container.
#
# The BTQR_* settings are for the upcoming /v1/tags endpoint (see PLAN.md); nothing reads them yet.
# PORT is used now by the container's uvicorn command.

# Shared secret the Go backend sends in the X-Internal-Token header.
# Leave empty to disable the check (the service is still only reachable on the Docker network).
BTQR_API_TOKEN=

# Comma-separated hosts that presigned upload URLs may point to. Anything else is rejected,
# so the service can't be used to send requests to arbitrary hosts.
BTQR_ALLOWED_UPLOAD_HOSTS=*.r2.cloudflarestorage.com

# Largest QR resolution (the "size" option) callers may request. Higher = smoother but much bigger STLs.
BTQR_MAX_QR_SIZE_PX=400

# Largest plate width/height in mm callers may request.
BTQR_MAX_BASE_MM=150

# Timeout for each upload to R2, in seconds.
BTQR_UPLOAD_TIMEOUT_S=60

# DEBUG, INFO, WARNING or ERROR.
BTQR_LOG_LEVEL=INFO

# Port uvicorn listens on inside the container.
PORT=8000
